{
  "name": "thai.ler.dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:vercel": "sh scripts/e2e-vercel.sh",
    "deploy:preview": "vercel deploy --yes",
    "gen:fixture": "tsx scripts/gen-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@base-ui/react": "1.8.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@fontsource/sarabun": "5.3.0",
    "@radix-ui/colors": "3.0.0",
    "@remix-run/node-fetch-server": "0.14.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.7",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.37",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "6.2.5",
    "oxlint": "^1.79.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.0"
  }
}
